#!/usr/bin/env bash
# one-command check (typecheck + lint + test) — established by dz-runner setup mode. One command; adjust as the repo grows.
#
# ── CI parity ────────────────────────────────────────────────────────────────
# Every job in .github/workflows/ci.yml, the exact command it runs, and whether
# this gate runs the same thing. The gate covers every BLOCKING CI job.
#
#   CI job         | CI command (working-directory)                        | bin/check
#   ---------------|---------------------------------------------------------|----------
#   rust / fmt     | cargo fmt --all -- --check                           | yes
#   rust / clippy  | cargo clippy --workspace --all-targets -- -D warnings | yes
#   rust / check   | cargo check --workspace --all-targets                | yes
#   rust / test    | cargo nextest run --workspace --profile ci           | yes
#   rust / deny    | cargo deny check                                     | yes
#   rust / audit   | cargo audit                                          | NO — advisory
#   scripts / test | bun test                        (scripts/)          | yes
#   scripts / lint | bun x biome check .             (scripts/)          | yes
#   docs / spdx    | tracked-file SPDX header sweep                      | yes (sweep below)
#
# `rust / audit` is the one deliberate divergence: ci.yml:181-188 runs that job
# with `continue-on-error: true` ("Advisory-level — never fails the build"), and
# bin/setup provisions only cargo-nextest and cargo-deny (bin/setup:314-317) —
# cargo-audit is unprovisioned, unpinned and network-dependent here. Putting it
# in this chain would add a tool the gate does not install and would break the
# exact cargo/bun call sequence scripts/tests/bin-scripts.test.ts asserts. CI
# keeps it as an advisory signal for the security-reviewer; the hard gate is
# `rust / deny`.
#
# `docs / spdx` was the one BLOCKING CI job this gate did not run: the SPDX
# header sweep lived only in ci.yml:288-334, so `bin/check` passed on a tree
# CI rejects (Law 7). The sweep below mirrors that job exactly — the same five
# tracked subtrees, the same exemption list, the same 15-line
# 'SPDX-License-Identifier:' window, the same two messages and the same exit 1 —
# using git and bash builtins only (no cargo, no bun, no fork per file). It runs
# after the exit-69 tool probes and before the cargo chain: a missing header is
# a Law 7 failure that must be reported in seconds rather than after a full
# build, and the chain stays the last statement, so its exit status is still the
# gate's exit status.
set -euo pipefail
cd "$(dirname "$0")/.."
# bin/setup puts the gate tools in the cargo and bun bin dirs but leaves them off PATH, so a
# caller whose PATH omits them would die mid-gate with 'no such command: nextest'. Put them on
# PATH first, then fail early (69 = EX_UNAVAILABLE) with a 'run ./bin/setup first' message when
# a tool the gate needs is genuinely absent: a missing tool is a setup problem, not a red gate.
export PATH="$HOME/.cargo/bin:$HOME/.bun/bin:$PATH"
missing=""
for tool in cargo cargo-nextest cargo-deny bun; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    missing="${missing}${missing:+, }${tool}"
  fi
done
if [ -n "$missing" ]; then
  echo "bin/check: gate tool(s) not on PATH: ${missing}; run ./bin/setup first" >&2
  exit 69
fi
# rustfmt and clippy are rustup components, not standalone binaries: cargo dispatches to
# cargo-fmt / cargo-clippy, which fail when the component is absent for the pinned toolchain.
if ! cargo fmt --version >/dev/null 2>&1; then
  echo "bin/check: the rustfmt component is missing; run ./bin/setup first" >&2
  exit 69
fi
if ! cargo clippy --version >/dev/null 2>&1; then
  echo "bin/check: the clippy component is missing; run ./bin/setup first" >&2
  exit 69
fi

cargo fmt --all -- --check
cargo clippy --workspace --all-targets -- -D warnings
cargo check --workspace --all-targets
cargo nextest run --workspace --profile ci
cargo deny check
(
  cd scripts
  bun test
  bun x biome check .
)

# Match CI's tracked-file SPDX policy. Capture enumeration separately: failures
# inside process substitution would otherwise be lost by the reading loop.
tracked_files=$(mktemp)
trap 'rm -f "$tracked_files"' EXIT
if git ls-files -z -- 'crates/**' 'packages/**' 'scripts/**' 'docs/**' '.github/**' > "$tracked_files"; then
  :
else
  status=$?
  echo "bin/check: tracked-file enumeration failed (exit $status)" >&2
  exit "$status"
fi
missing=()
while IFS= read -r -d '' f; do
  case "$f" in
    *.lock|*.png|*.jpg|*.jpeg|*.webp|*.ico|*.gif|*.svg|*.wasm|*.bin)
      continue ;;
    *.json|*/bun.lock|*/Cargo.lock|*/package-lock.json)
      continue ;;
    */node_modules/*|*/target/*|*/.git/*)
      continue ;;
    *.snap|*/snapshots/*)
      continue ;;
    */.placeholder|*/.bun-version|*/.keep|*/.nvmrc)
      continue ;;
  esac
  # Consume all 15 lines: grep -q/-m1 could SIGPIPE head on long lines under
  # pipefail, rejecting a valid header. Acceptance stays identical to CI.
  if ! head -n 15 "$f" | grep 'SPDX-License-Identifier:' > /dev/null; then
    missing+=("$f")
  fi
done < "$tracked_files"
if [[ ${#missing[@]} -gt 0 ]]; then
  printf 'Missing SPDX header in %d file(s):\n' "${#missing[@]}" >&2
  printf '  %s\n' "${missing[@]}" >&2
  exit 1
fi
echo "SPDX headers OK on all tracked files under crates/, packages/, scripts/, docs/, .github/"

# CI treats audit as advisory. Attempt it even when cargo-audit is unavailable;
# retain cargo's diagnostics without making it a setup requirement or hard gate.
if cargo audit; then
  echo "bin/check: cargo audit completed (advisory)" >&2
else
  status=$?
  echo "bin/check: cargo audit failed or unavailable (exit $status; advisory, nonblocking)" >&2
fi
